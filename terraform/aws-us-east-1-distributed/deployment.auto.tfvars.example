aws_profile       = "default"
region            = "us-east-1"
availability_zone = "us-east-1a"
vpc_id            = "vpc-0123456789abcdef0"
subnet_id         = "subnet-0123456789abcdef0"
run_id            = "kvs-distributed-001"

# A promoted AMI makes readiness a validation-only path.
runner_bootstrap_mode = "prebaked"
runner_ami_id         = "ami-0123456789abcdef0"

# Pin the required runner container digest independently of the AMI.
# runner_image  = "ghcr.io/example/kvs-benchmark-runner@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

tags = {
  Environment = "benchmark"
  Owner       = "performance-engineering"
}
