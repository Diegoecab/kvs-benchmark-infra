#cloud-config
package_update: false

write_files:
  - path: /etc/kvs-benchmark-runner-release
    owner: root:root
    permissions: "0444"
    content: |
      schemaVersion=2
      runnerType=aws-kvs-benchmark
      bootstrapMode=${bootstrap_mode}
      runId=${run_id}
      source=source-${format("%02d", runner_index)}
      image=${runner_image}
  - path: /usr/local/sbin/kvs-runner-bootstrap
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      runner_image='${runner_image}'
      bootstrap_mode='${bootstrap_mode}'

      if [[ "$bootstrap_mode" == "install" ]]; then
        if [[ ! -f /swapfile ]]; then
          fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=progress
          chmod 0600 /swapfile
          mkswap /swapfile
        fi
        swapon --show=NAME --noheadings | grep -qx /swapfile || swapon /swapfile
        grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
        sed -i 's|http://|https://|g' /etc/apt/sources.list 2>/dev/null || true
        sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
        timeout 600 apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update
        DEBIAN_FRONTEND=noninteractive timeout 900 apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y chrony curl podman unzip
        if ! command -v aws >/dev/null; then
          curl -fsSL 'https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip' -o /tmp/awscliv2.zip
          rm -rf /tmp/aws
          unzip -q /tmp/awscliv2.zip -d /tmp
          /tmp/aws/install --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli
        fi
        if ! systemctl list-unit-files | grep -F amazon-ssm-agent >/dev/null; then
          curl -fsSL 'https://s3.${region}.amazonaws.com/amazon-ssm-${region}/latest/debian_amd64/amazon-ssm-agent.deb' -o /tmp/amazon-ssm-agent.deb
          dpkg -i /tmp/amazon-ssm-agent.deb
        fi
        podman pull "$runner_image"
      else
        test -r /etc/kvs-benchmark-image-release
        grep -Fx "provider=aws" /etc/kvs-benchmark-image-release
        grep -Fx "runnerImage=$runner_image" /etc/kvs-benchmark-image-release
      fi

      systemctl enable --now amazon-ssm-agent.service || systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service
      systemctl enable --now chrony || systemctl enable --now chronyd
      install -d -o root -g root -m 0755 /opt/kvs-dashboard
      install -d -o root -g root -m 0755 /opt/kvs-dashboard/${run_id}
      podman image exists "$runner_image"
      aws --version
      chronyc tracking >/dev/null
      systemctl is-active --quiet amazon-ssm-agent.service || systemctl is-active --quiet snap.amazon-ssm-agent.amazon-ssm-agent.service
      touch /var/lib/cloud/instance/kvs-benchmark-ready

runcmd:
  - [/usr/local/sbin/kvs-runner-bootstrap]
