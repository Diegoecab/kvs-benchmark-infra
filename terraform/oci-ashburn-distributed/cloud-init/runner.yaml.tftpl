#cloud-config
package_update: false

# The benchmark deliberately uses 1 GiB runners. The promoted image already
# contains this swap file; the install path creates it before dnf starts.
bootcmd:
  - [bash, -lc, "test -f /var/swapfile || fallocate -l 2G /var/swapfile"]
  - [chmod, "0600", /var/swapfile]
  - [bash, -lc, "mkswap /var/swapfile >/dev/null 2>&1 || true"]
  - [bash, -lc, "swapon /var/swapfile || true"]
  - [bash, -lc, "grep -q '^/var/swapfile ' /etc/fstab || echo '/var/swapfile none swap defaults 0 0' >> /etc/fstab"]

write_files:
  - path: /etc/kvs-benchmark-runner-release
    owner: root:root
    permissions: "0444"
    content: |
      schemaVersion=2
      runnerType=oci-kvs-benchmark
      bootstrapMode=${bootstrap_mode}
      runId=${run_id}
      target=${target}
      sourceIndex=${source}
      image=${runner_image}
  - path: /usr/local/sbin/kvs-runner-bootstrap
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      runner_image='${runner_image}'
      bootstrap_mode='${bootstrap_mode}'

      if [[ "$bootstrap_mode" == "install" ]]; then
        # A newly-created NAT can become routable a few seconds after the VM
        # starts. Do not let a transient DNS/repository race poison cloud-init.
        for attempt in $(seq 1 60); do
          if getent ahostsv4 yum.oracle.com >/dev/null 2>&1; then break; fi
          sleep 5
        done
        getent ahostsv4 yum.oracle.com >/dev/null
        for attempt in $(seq 1 12); do
          if dnf install -y chrony jq podman tar gzip; then break; fi
          if [[ "$attempt" == "12" ]]; then exit 1; fi
          sleep 15
        done
        rpm -q chrony jq podman tar gzip >/dev/null
        podman pull "$runner_image"
      else
        test -r /etc/kvs-benchmark-image-release
        grep -Fx "provider=oci" /etc/kvs-benchmark-image-release
        grep -Fx "runnerImage=$runner_image" /etc/kvs-benchmark-image-release
      fi

      cat > /etc/sudoers.d/101-oracle-cloud-agent-kvs-benchmark <<'SUDOERS'
      ocarun ALL=(root) NOPASSWD: /usr/bin/podman *, /usr/bin/mkdir *, /usr/bin/chmod *, /usr/bin/chown *, /usr/bin/install *, /usr/bin/chronyc *, /usr/bin/jq *
      SUDOERS
      chmod 0440 /etc/sudoers.d/101-oracle-cloud-agent-kvs-benchmark

      systemctl enable --now chronyd
      systemctl enable --now oracle-cloud-agent
      getent passwd ocarun >/dev/null
      getent group oracle-cloud-agent >/dev/null
      install -d -o root -g oracle-cloud-agent -m 0750 /opt/kvs-dashboard
      install -d -o root -g oracle-cloud-agent -m 0750 /opt/kvs-dashboard/results
      visudo -cf /etc/sudoers.d/101-oracle-cloud-agent-kvs-benchmark
      podman image exists "$runner_image"
      sudo -u ocarun sudo -n /usr/bin/podman image exists "$runner_image"
      chronyc tracking >/dev/null
      touch /var/lib/cloud/instance/kvs-benchmark-ready

runcmd:
  - [/usr/local/sbin/kvs-runner-bootstrap]
