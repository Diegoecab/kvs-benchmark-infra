#cloud-config
package_update: true
packages:
  - chrony
  - jq
  - podman
  - tar
  - gzip

# The benchmark deliberately uses 1 GiB runners. Bring up swap before dnf and
# Podman so cloud-init cannot starve the Oracle Cloud Agent during bootstrap.
bootcmd:
  - [bash, -lc, "test -f /var/swapfile || fallocate -l 2G /var/swapfile"]
  - [chmod, "0600", /var/swapfile]
  - [bash, -lc, "mkswap /var/swapfile >/dev/null 2>&1 || true"]
  - [bash, -lc, "swapon /var/swapfile || true"]
  - [bash, -lc, "grep -q '^/var/swapfile ' /etc/fstab || echo '/var/swapfile none swap defaults 0 0' >> /etc/fstab"]

write_files:
  - path: /etc/sudoers.d/101-oracle-cloud-agent-kvs-benchmark
    owner: root:root
    permissions: "0440"
    content: |
      ocarun ALL=(root) NOPASSWD: /usr/bin/podman *, /usr/bin/mkdir *, /usr/bin/chmod *, /usr/bin/chown *, /usr/bin/install *, /usr/bin/chronyc *, /usr/bin/jq *
  - path: /etc/kvs-benchmark-runner-release
    owner: root:root
    permissions: "0444"
    content: |
      schemaVersion=1
      runnerType=oci-kvs-benchmark
      runId=${run_id}
      target=${target}
      sourceIndex=${source}
      image=${runner_image}

runcmd:
  - [systemctl, enable, --now, chronyd]
  - [systemctl, enable, --now, oracle-cloud-agent]
  - [install, -d, -o, root, -g, ocarun, -m, "0750", /opt/kvs-dashboard]
  - [install, -d, -o, root, -g, ocarun, -m, "0750", /opt/kvs-dashboard/results]
  - [visudo, -cf, /etc/sudoers.d/101-oracle-cloud-agent-kvs-benchmark]
  - [podman, pull, "${runner_image}"]
  - [bash, -lc, "sudo -u ocarun sudo -n /usr/bin/podman image exists '${runner_image}'"]
  - [bash, -lc, "chronyc tracking >/dev/null"]
  - [touch, /var/lib/cloud/instance/kvs-benchmark-ready]
